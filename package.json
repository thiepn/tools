{
  "name": "tiny-tools",
  "private": true,
  "version": "0.19.0",
  "description": "A privacy-first collection of 327 public browser utility routes for PDFs, diagnostics, calculators, file conversion, Office/eBooks, images, media, text, study, privacy, security, developer, documents, planning, math, design, web, and everyday tasks.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "browser:smoke": "node scripts/r5-browser-smoke-expanded.mjs",
    "browser:functional": "node scripts/r6-functional-smoke.mjs",
    "browser:capabilities": "node scripts/r7-capability-ci.mjs",
    "browser:compatibility": "node scripts/r8-compatibility-smoke.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@imgly/background-removal": "^1.7.0",
    "jsbarcode": "^3.12.3",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.11"
  },
  "overrides": { "adm-zip": "0.6.0", "sharp": "0.35.4" }
}
